  "concepts": [
    {
      "nameEn": "Half-Life",
      "nameAr": "عمر النصف",
      "visual": "50 % of what remains is eliminated each half-life: 50 / 75 / 87.5 / 93.75 / 96.9 % after 1–5 half-lives. t½ = 0.693 × Vd / CL."
    },
    {
      "nameEn": "Steady State",
      "nameAr": "الحالة المستقرة",
      "visual": "Repeated dosing accumulates to plateau by ~5 half-lives."
    },
    {
      "nameEn": "Loading Dose",
      "nameAr": "جرعة التحميل",
      "visual": "Reaches the target level at once: loading dose = target Cp × Vd / F."
    },
    {
      "nameEn": "First-Pass Metabolism",
      "nameAr": "تأثير المرور الأول",
      "visual": "PO drug loss in liver before systemic circulation."
    },
    {
      "nameEn": "Bioavailability",
      "nameAr": "التوافر الحيوي",
      "visual": "IV is 100%; PO variable by absorption and first pass."
    },
    {
      "nameEn": "Volume of Distribution",
      "nameAr": "حجم التوزيع",
      "visual": "Large Vd tissue binding vs small Vd vascular confinement."
    },
    {
      "nameEn": "Protein Binding",
      "nameAr": "الارتباط البروتيني",
      "visual": "Free drug active, bound fraction reservoir."
    },
    {
      "nameEn": "Therapeutic Window",
      "nameAr": "النافذة العلاجية",
      "visual": "Range between the minimum effective and minimum toxic concentration. Therapeutic index = TD50/ED50; narrow-index drugs include digoxin, lithium, phenytoin, aminoglycosides and vancomycin."
    },
    {
      "nameEn": "Clearance",
      "nameAr": "التصفية",
      "visual": "Volume of plasma cleared per unit time (renal + hepatic). Maintenance dose rate = CL × Css / F."
    },
    {
      "nameEn": "Context-Sensitive Half-Time",
      "nameAr": "عمر النصف المعتمد على المدة",
      "visual": "Longer infusion increases recovery time."
    },
    {
      "nameEn": "Receptor Occupancy",
      "nameAr": "إشغال المستقبلات",
      "visual": "Dose-response: threshold, linear, plateau."
    },
    {
      "nameEn": "PK Drug Interactions",
      "nameAr": "التداخلات الحركية",
      "visual": "CYP inhibition increases levels; induction decreases."
    }
  ],
